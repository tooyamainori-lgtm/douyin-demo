# ============================================================
# Douyin Web Demo — 环境变量配置模板
# 复制为 .env 后按需修改，docker compose 自动读取
# cp .env.example .env
# ============================================================

# MySQL 数据库
MYSQL_ROOT_PASSWORD=123456

# MinIO 对象存储（access key 和 secret key 需与 ROOT_USER/ROOT_PASSWORD 一致）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# JWT 签名密钥（生产环境请更换为随机字符串，至少 256 位）
JWT_SECRET=douyin-docker-jwt-secret-key-must-be-at-least-256-bits-long!!
